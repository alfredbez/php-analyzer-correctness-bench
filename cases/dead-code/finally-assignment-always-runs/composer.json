{
  "name": "bench/dead-code-finally-assignment-always-runs",
  "description": "PHPStan reads a finally assignment as if it never ran",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpstan/phpstan": "2.3.1",
    "vimeo/psalm": "6.20.0"
  },
  "autoload": {
    "files": ["src/repro.php"]
  },
  "scripts": {
    "analyze": [
      "phpstan analyse --level=9 --no-progress src",
      "psalm --no-progress",
      "mago analyze src"
    ],
    "runtime-check": "php runtime/check.php"
  }
}
