{
  "name": "bench/nullability-loose-null-guard-keeps-empty-string",
  "description": "'' == null is true but '' === null is false, so the strict check inside the loose guard is not redundant",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpstan/phpstan": "2.3.1",
    "vimeo/psalm": "6.20.0"
  },
  "autoload": {
    "files": ["src/repro.php"]
  },
  "scripts": {
    "analyze": [
      "phpstan analyse --level=9 --no-progress src",
      "psalm --no-progress --config=psalm.xml",
      "mago analyze src"
    ],
    "runtime-check": "php runtime/check.php"
  }
}
