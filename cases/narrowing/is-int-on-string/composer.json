{
  "name": "bench/narrowing-is-int-on-string",
  "description": "is_int() on a string parameter guards an unreachable branch",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpstan/phpstan": "2.3.1",
    "vimeo/psalm": "6.20.0"
  },
  "autoload": {
    "files": ["src/repro.php"]
  },
  "scripts": {
    "analyze": [
      "phpstan analyse --level=9 --no-progress src",
      "psalm --no-progress --config=psalm.xml",
      "mago analyze src"
    ],
    "runtime-check": "php runtime/check.php"
  }
}
