{
  "name": "bench/callables-negated-is-callable-removes-function-name",
  "description": "!is_callable() removes a function-name string from a string|array union",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpstan/phpstan": "2.3.1",
    "vimeo/psalm": "6.20.0"
  },
  "autoload": {
    "files": ["src/repro.php"]
  },
  "scripts": {
    "analyze": [
      "phpstan analyse --level=9 --no-progress src",
      "psalm --no-progress --config=psalm.xml",
      "mago analyze src"
    ],
    "runtime-check": "php runtime/check.php"
  }
}
