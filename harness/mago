#!/usr/bin/env bash
# Mago shim, the counterpart of harness/php.
#
# Mago is a static binary, so it does not need the PHP entry point, but it does
# need to run where the repository is mounted - and it must address the same
# container that the harness created for this checkout. Both sides derive the
# container name from the repository root, so parallel worktrees cannot collide.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE="${BENCH_PHP_IMAGE:-php:8.3-cli}"
DIGEST="$(printf '%s' "$ROOT" | sha1sum | cut -c1-8)"
CONTAINER="${BENCH_CONTAINER:-bench-${IMAGE//:/-}-$DIGEST}"

if [ "${BENCH_PHP:-docker}" = "native" ]; then
  exec "$ROOT/tools/bin/mago" "$@"
fi
exec docker exec -u "$(id -u):$(id -g)" -e HOME=/tmp -w /bench "$CONTAINER" /bench/tools/bin/mago "$@"
