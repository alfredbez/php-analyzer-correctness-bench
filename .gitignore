# Analyzer binaries are installed by tools/install.sh, never committed.
tools/bin/*
!tools/bin/.gitkeep

# Per-case generated state.
cases/**/vendor/
cases/**/.generated/
cases/**/composer.lock

# Run artifacts. results/latest and results/runs/<run>/SUMMARY.md, MATRIX.md and
# report.json are committed on purpose; the raw tool output of a run is not.
results/runs/**/raw/
results/latest

# Autonomous factory scratch space.
factory/evidence/
factory/prompts/
factory/*.log

__pycache__/
*.pyc
