# Analyzer binaries are installed by tools/install.sh, never committed.
tools/bin/*
!tools/bin/.gitkeep

# Per-case generated state.
cases/**/vendor/
cases/**/.generated/
cases/**/composer.lock

# Analyzer binaries staged from outside the repository for an override run.
.tools-alt/
.tools-alt/

# Run artifacts. The newest run directories are committed - they are the report -
# but the raw tool output inside them is not. results/latest is a regenerated
# convenience copy of the newest run.
results/runs/**/raw/
results/latest

# Autonomous factory scratch space.
factory/evidence/
factory/prompts/
factory/*.log

__pycache__/
*.pyc
